APP_ENVIRONMENT=development
# Bind address for `python starter.py`.
APP_HOST=127.0.0.1
APP_PORT=8000

# PostgreSQL is required for conversation and document metadata.
DATABASE_URL=postgresql://rag_user:change-me@localhost:5432/evidence_rag
# Required when APP_ENVIRONMENT is not development; protects data-bearing endpoints.
# API_KEY=replace-with-a-long-random-value

# A local path or a Hugging Face model identifier. The model is loaded only for indexing/querying.
EMBEDDING_MODEL=./bge-small-zh-v1.5
EMBEDDING_DEVICE=cpu

# Local storage. Defaults live in config.py; override here for another layout.
CHROMA_PATH=data/chroma
UPLOAD_DIR=data/uploads
RECORD_MANAGER_DB=data/record_manager.sqlite

# Ollama must be running before sending questions.
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_BASE_URL=http://localhost:11434

# Comma-separated browser origins permitted in development.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_SIZE_MB=20
MAX_EXTRACTED_CHARS=2000000
# The checked-in benchmark is read-only; the CLI writes its latest report here.
EVALUATION_DATASET_PATH=evaluation/dataset.json
EVALUATION_REPORT_PATH=evaluation/runs/latest.json

# Two-stage retrieval: RRF candidates -> optional Cross-Encoder reranking.
CANDIDATE_K=20
FINAL_CONTEXT_K=6
RRF_K=60
# Optional: local path or Hugging Face ID, for example BAAI/bge-reranker-v2-m3.
# RERANKER_MODEL=./bge-reranker-v2-m3

# Retrieval quality extensions.
QUERY_REWRITE_ENABLED=true
QUERY_REWRITE_TIMEOUT_SECONDS=8
GENERATION_TIMEOUT_SECONDS=120
PARENT_CHILD_ENABLED=true
RERANKER_TIMEOUT_SECONDS=20
PARENT_CHUNK_SIZE=1800
PARENT_CHUNK_OVERLAP=200
CHILD_CHUNK_SIZE=800
CHILD_CHUNK_OVERLAP=150

# Structure-aware evidence composition (estimated tokens, not model-tokenizer counts).
STRUCTURE_INDEXING_ENABLED=true
CONTEXT_TOKEN_BUDGET=6000
CONTEXT_MAX_DOCUMENTS=8
CONTEXT_NEIGHBOR_CHARS=240

# Adaptive research: simple questions use one pass; complex tasks inspect evidence gaps.
RESEARCH_MAX_ROUNDS=3
RESEARCH_MAX_TASKS=4
RESEARCH_TIME_BUDGET_SECONDS=90
RESEARCH_PLANNING_TOKEN_BUDGET=16000
RESEARCH_MODEL_TIMEOUT_SECONDS=25
# Evidence-backed graph traversal from explicit relation tables / relation statements.
GRAPH_ENABLED=true
GRAPH_MAX_HOPS=2
GRAPH_MAX_EXPANSION_QUERIES=3

# Semantic audit uses the configured Ollama model; auxiliary judgment, not proof.
CLAIM_AUDIT_ENABLED=true
CLAIM_AUDIT_MAX_CLAIMS=12
CLAIM_AUDIT_TIMEOUT_SECONDS=45

# Version 2 research delivery.
REPORT_MAX_SECTIONS=8
REPORT_WORKER_TIMEOUT_SECONDS=1200
ASSET_DIR=data/assets
PDF_PAGE_RENDER_ENABLED=true
# Choose an actually vision-capable Ollama model for image/page analysis.
# VISION_MODEL=qwen2.5vl:7b
VISION_INDEXING_ENABLED=false
VISION_MAX_PAGES=8
VISION_TIMEOUT_SECONDS=60
